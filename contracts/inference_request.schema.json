{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurotaskfm.org/contracts/inference_request.schema.json",
  "title": "NeuroTaskFM inference request",
  "type": "object",
  "required": ["request_id", "query", "output_dir", "config"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "subject_key": {"type": "string"},
    "pack": {"type": "string"},
    "source_task": {"type": "string"},
    "source_contrast": {"type": "string"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack"],
        "properties": {
          "pack": {"type": "string", "minLength": 1},
          "task": {"type": "string"},
          "contrast": {"type": "string"},
          "visit": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "signature": {"type": "string"},
    "query": {
      "type": "object",
      "required": ["task"],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "contrast": {"type": "string"}
      },
      "additionalProperties": true
    },
    "output_dir": {"type": "string", "minLength": 1},
    "config": {"type": "string", "minLength": 1}
  },
  "anyOf": [{"required": ["pack"]}, {"required": ["observations"]}, {"required": ["signature"]}],
  "additionalProperties": false
}
