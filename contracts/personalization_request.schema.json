{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurotaskfm.org/contracts/personalization_request.schema.json",
  "title": "NeuroTaskFM personalization request",
  "type": "object",
  "required": ["request_id", "packs", "output", "config"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "packs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "queries": {"type": "array", "items": {"type": "string"}},
    "output": {"type": "string", "minLength": 1},
    "config": {"type": "string", "minLength": 1},
    "steps": {"type": "integer", "minimum": 1, "maximum": 2000},
    "learning_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1}
  },
  "additionalProperties": false
}
